{
  "name": "token-atlas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/next.mjs dev --hostname 127.0.0.1",
    "build": "node scripts/next.mjs build",
    "start": "node scripts/next.mjs start --hostname 127.0.0.1",
    "lint": "eslint",
    "format": "prettier --write .",
    "typecheck": "node scripts/next.mjs typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "openspec": "node scripts/openspec.mjs",
    "spec:validate": "node scripts/openspec.mjs validate --all --strict --no-interactive",
    "check": "npm run lint && npm run typecheck && npm test && npm run spec:validate",
    "collect": "tsx scripts/collect.ts",
    "test:run": "vitest run",
    "qa:verify": "node scripts/qa-verify.mjs",
    "qa:record-demos": "node scripts/record-demos.mjs",
    "check:trace": "node scripts/check-traceability.mjs",
    "check:coverage": "node scripts/check-coverage-ratchet.mjs",
    "check:eval": "node scripts/check-eval-ratchet.mjs",
    "check:trajectory": "node scripts/check-trajectory.mjs",
    "check:recordings": "node scripts/check-recordings.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "gate:status": "node scripts/gate-status.mjs",
    "correct": "node scripts/correct.mjs",
    "retro:digest": "node scripts/ledger-report.mjs",
    "check:acceptance": "node scripts/check-acceptance-methods.mjs --mode=existence",
    "check:acceptance:artifact": "node scripts/check-acceptance-methods.mjs --mode=artifact",
    "check:process": "node scripts/check-process-ratchet.mjs",
    "check:integrity": "node scripts/check-factory-integrity.mjs",
    "check:visual": "node scripts/check-visual-fidelity.mjs"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "dependencies": {
    "lucide-react": "1.46.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "24.13.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prettier": "3.9.6",
    "tailwindcss": "^4",
    "tsx": "4.23.13",
    "typescript": "^5",
    "vitest": "5.0.1"
  }
}
